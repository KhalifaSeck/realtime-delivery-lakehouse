# ============================================================
# realtime-delivery-lakehouse — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs.
# Le fichier .env ne doit JAMAIS être commité.
# ============================================================

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_GPS=gps_positions
KAFKA_TOPIC_DELIVERY=delivery_events
KAFKA_TOPIC_ORDERS=orders
KAFKA_TOPIC_DRIVERS=driver_events

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400

# ---------- Simulateur ----------
SIM_NB_DRIVERS=20
SIM_TICK_SECONDS=2
SIM_CITY=Montreal

# ---------- Spark ----------
# IMPORTANT : chemin HORS OneDrive (ex. C:\spark-checkpoints)
SPARK_CHECKPOINT_DIR=C:\spark-checkpoints
SPARK_MASTER=local[*]

# ---------- Azure Data Lake Gen2 ----------
ADLS_ACCOUNT_NAME=
ADLS_CONTAINER=delivery-events
ADLS_SAS_TOKEN=

# ---------- Snowflake ----------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DELIVERY_LAKEHOUSE
SNOWFLAKE_SCHEMA=RAW

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Data Lake (sortie Parquet) ----------
# En dev local : chemin hors OneDrive. En prod : sera remplacé par le chemin ADLS.
LAKE_OUTPUT_DIR=C:\delivery-lake